{
  "font": {
    "sans": { "$value": "'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif", "$type": "fontFamily" },
    "display": { "$value": "'Outfit', 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif", "$type": "fontFamily" },
    "mono": { "$value": "'JetBrains Mono', 'Fira Code', 'Roboto Mono', Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace", "$type": "fontFamily" },
    "serif": { "$value": "'Newsreader', 'Merriweather', 'Georgia', Cambria, 'Times New Roman', Times, serif", "$type": "fontFamily" },
    "weight": {
      "light": { "$value": "300", "$type": "fontWeight" },
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium": { "$value": "500", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold": { "$value": "700", "$type": "fontWeight" },
      "extrabold": { "$value": "800", "$type": "fontWeight" },
      "black": { "$value": "900", "$type": "fontWeight" }
    }
  }
