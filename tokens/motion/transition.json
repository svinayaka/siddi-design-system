{
  "ease": {
    "default": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" },
    "in": { "$value": "cubic-bezier(0.4, 0, 1, 1)" },
    "out": { "$value": "cubic-bezier(0, 0, 0.2, 1)" },
    "in-out": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" },
    "spring": { "$value": "cubic-bezier(0.175, 0.885, 0.32, 1.275)" }
  },
  "duration": {
    "fast": { "$value": "150ms", "$type": "duration" },
    "normal": { "$value": "200ms", "$type": "duration" },
    "slow": { "$value": "300ms", "$type": "duration" },
    "slower": { "$value": "500ms", "$type": "duration" }
  },
  "transition": {
    "fast": { "$value": "all {duration.fast} {ease.default}" },
    "normal": { "$value": "all {duration.normal} {ease.default}" },
    "slow": { "$value": "all {duration.slow} {ease.default}" }
  }
}
