{
  "name": "@svinayaka/siddi-design-system",
  "version": "1.0.0",
  "description": "Design system tokens and core stylesheets for Siddi applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svinayaka/siddi-design-system.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./src/index.css",
  "style": "./src/index.css",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.css",
    "./colors": "./src/colors.css",
    "./spacing": "./src/spacing.css",
    "./typography": "./src/typography.css",
    "./breakpoints": "./src/breakpoints.css",
    "./light": "./src/light.css",
    "./dark": "./src/dark.css",
    "./tokens": {
      "types": "./src/tokens.d.ts",
      "import": "./src/tokens.js",
      "default": "./src/tokens.js"
    },
    "./*": "./src/*"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "design-system",
    "css",
    "tokens",
    "theme",
    "dark-mode",
    "light-mode",
    "siddi"
  ],
  "scripts": {
    "build": "node build.ts",
    "prepublishOnly": "npm run build",
    "preview": "http-server . -o /test.html",
    "test": "tsc --noEmit && npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.2",
    "http-server": "^14.1.1",
    "style-dictionary": "^5.5.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
